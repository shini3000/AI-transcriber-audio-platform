HOST_IP=localhost

RabbitMQ__Host=${HOST_IP}
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=guest
RabbitMQ__ExchangeName=capstone.audio
RabbitMQ__RoutingKey=audio.uploaded
RabbitMQ__ValidatedRoutingKey=audio.validated

MinIO__Endpoint=${HOST_IP}:9000
MinIO__AccessKey=minioadmin
MinIO__SecretKey=minioadmin
MinIO__BucketName=audio
MinIO__UseSsl=false

ConnectionStrings__DefaultConnection=Host=${HOST_IP};Database=capstone_audio;Username=postgres;Password=postgres

Validator__MaxConcurrency=4
Validator__ShutdownTimeoutSeconds=15
Validator__PollIntervalMs=500
